---
import Base from './Base.astro';
import Logo from '../components/Logo.astro';
import { site, nav } from '../data/church';
import '../styles/church.css';
interface Props { title: string; description?: string; section?: string; index?: boolean; heading?: string; lead?: string; eyebrow?: string; home?: boolean }
const { title, description = `${title}: ${site.name}, a fictional church.`, section = 'Pages', index = true, heading, lead, eyebrow, home = false } = Astro.props;
const path = Astro.url.pathname;
---
<Base title={title} description={description} siteName={site.name}>
  <div slot="header" class="site-head">
    <div class="wrap bar">
      <a class="brand" href="/"><Logo /><span class="brand-text"><span class="brand-name">{site.short}</span><span class="brand-sub">Community Church</span></span></a>
      <nav aria-label="Main">
        <ul>
          {nav.map((n) => (
            <li><a class={n.href === '/give' ? 'give' : undefined} href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
  <div data-pagefind-body={index ? '' : undefined} data-pagefind-ignore={index ? undefined : 'all'}>
    {index && <meta data-pagefind-filter="section[content]" content={section} />}
    {!home && heading && (
      <header class="page-head">
        <div class="wrap">
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          <h1>{heading}</h1>
          {lead && <p class="lead">{lead}</p>}
          <svg class="orn" aria-hidden="true" width="120" height="14" viewBox="0 0 120 14"><path d="M0 7h46M74 7h46" stroke="currentColor" stroke-width="1.500"/><path d="M60 0l6 7-6 7-6-7z" fill="currentColor"/></svg>
        </div>
      </header>
    )}
    <slot />
  </div>
  <div slot="footer" class="site-foot">
    <div class="wrap">
      <Logo />
      <p class="foot-name">{site.name}</p>
      <p class="foot-line">{site.address}<br />{site.phone} · <a href={`mailto:${site.email}`}>{site.email}</a><br />Office: {site.office}</p>
      <ul class="foot-links">{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
      <p class="legal"><a href="/accessibility">Accessibility statement</a></p>
    </div>
  </div>
</Base>
