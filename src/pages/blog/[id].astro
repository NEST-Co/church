---
import { getCollection, render } from 'astro:content';
import Church from '../../layouts/Church.astro';
import CoverArt from '../../components/CoverArt.astro';
import { fmt } from '../../data/church';
export async function getStaticPaths() {
  return (await getCollection('blog')).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Church title={d.title} description={d.summary} section="Blog" eyebrow={fmt(d.date)} heading={d.title} lead={d.summary}>
  <div class="wrap body">
    <div class="cover-hero"><CoverArt id={entry.id} ratio="16 / 7" /></div>
    <div class="narrow" style="margin-bottom:1.5rem">
      <p style="margin:0"><a class="crumb" href="/blog">&larr; All posts</a><br /><span class="meta"><time datetime={d.date.toISOString().slice(0, 10)}>{fmt(d.date)}</time> · {d.author}</span></p>
    </div>
    <div class="prose drop">
      <Content />
      <h2 style="font-size:1.1rem">Topics</h2>
      <ul class="tags">{d.tags.map((t) => <li><a class="tag" href={`/blog/tag/${t}`}>{t}</a></li>)}</ul>
    </div>
  </div>
</Church>
