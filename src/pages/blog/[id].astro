---
import { getCollection, render } from 'astro:content';
import Church from '../../layouts/Church.astro';
import { fmt } from '../../data/church';
export async function getStaticPaths() {
  return (await getCollection('blog')).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Church title={d.title} description={d.summary} section="Blog">
  <div class="wrap prose">
    <p><a href="/blog">&larr; All posts</a></p>
    <h1>{d.title}</h1>
    <p class="meta"><time datetime={d.date.toISOString().slice(0, 10)}>{fmt(d.date)}</time> · {d.author}</p>
    <Content />
    <h2 style="font-size:1.1rem">Topics</h2>
    <ul class="tags">{d.tags.map((t) => <li><a class="tag" href={`/blog/tag/${t}`}>{t}</a></li>)}</ul>
  </div>
</Church>
