---
import { getCollection } from 'astro:content';
import Church from '../../../layouts/Church.astro';
import CoverArt from '../../../components/CoverArt.astro';
import { fmt } from '../../../data/church';
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)).sort((a, b) => +b.data.date - +a.data.date) },
  }));
}
const { tag, posts } = Astro.props;
---
<Church title={`Posts about ${tag}`} section="Blog" index={false} eyebrow="Topic" heading={`Posts about ${tag}`}>
  <div class="wrap body">
    <p style="text-align:center"><a href="/blog">&larr; All posts</a></p>
    <ul class="grid3">{posts.map((p) => (
      <li><article class="card"><CoverArt id={p.id} /><div class="txt">
        <p class="meta"><time datetime={p.data.date.toISOString().slice(0, 10)}>{fmt(p.data.date)}</time></p>
        <h2><a href={`/blog/${p.id}`}>{p.data.title}</a></h2><p>{p.data.summary}</p></div></article></li>
    ))}</ul>
  </div>
</Church>
