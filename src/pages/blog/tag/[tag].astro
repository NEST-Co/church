---
import { getCollection } from 'astro:content';
import Church from '../../../layouts/Church.astro';
import { fmt } from '../../../data/church';
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)).sort((a, b) => +b.data.date - +a.data.date) },
  }));
}
const { tag, posts } = Astro.props;
---
<Church title={`Posts about ${tag}`} section="Blog" index={false}>
  <div class="wrap">
    <p><a href="/blog">&larr; All posts</a></p>
    <h1>Posts about {tag}</h1>
    <ul class="list">{posts.map((p) => (
      <li><h2 style="font-size:1.35rem;margin:0"><a href={`/blog/${p.id}`}>{p.data.title}</a></h2>
        <p class="meta"><time datetime={p.data.date.toISOString().slice(0, 10)}>{fmt(p.data.date)}</time></p>
        <p>{p.data.summary}</p></li>
    ))}</ul>
  </div>
</Church>
