---
import { getCollection } from 'astro:content';
import Church from '../../layouts/Church.astro';
import CoverArt from '../../components/CoverArt.astro';
import { fmt } from '../../data/church';
const sermons = (await getCollection('sermons')).sort((a, b) => +b.data.date - +a.data.date);
const series = [...new Set(sermons.map((s) => s.data.series))];
---
<Church title="Sermons" section="Sermons" eyebrow="Listen and reflect" heading="Sermons" lead="Notes and discussion questions from recent Sundays. Audio is not part of this concept site.">
  <div class="wrap body">
    {series.map((name) => (
      <section>
        <h2 class="series">{name}</h2>
        <ul class="grid3">{sermons.filter((s) => s.data.series === name).map((s) => (
          <li><article class="card"><CoverArt id={s.id} /><div class="txt">
            <p class="meta"><time datetime={s.data.date.toISOString().slice(0, 10)}>{fmt(s.data.date)}</time> · {s.data.scripture}</p>
            <h3><a href={`/sermons/${s.id}`}>{s.data.title}</a></h3>
            <p>{s.data.summary}</p>
            <p class="meta" style="margin-top:auto;padding-top:.6rem">{s.data.speaker}</p></div></article></li>
        ))}</ul>
      </section>
    ))}
  </div>
</Church>
