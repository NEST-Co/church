---
import { getCollection, render } from 'astro:content';
import Church from '../../layouts/Church.astro';
import { fmt } from '../../data/church';
export async function getStaticPaths() {
  return (await getCollection('sermons')).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Church title={d.title} description={d.summary} section="Sermons">
  <div class="wrap prose">
    <p><a href="/sermons">&larr; All sermons</a></p>
    <h1>{d.title}</h1>
    <p class="meta"><time datetime={d.date.toISOString().slice(0, 10)}>{fmt(d.date)}</time> · {d.speaker} · {d.scripture} · Series: {d.series}</p>
    <Content />
  </div>
</Church>
