---
import Church from '../layouts/Church.astro';
import { site, services } from '../data/church';
---
<Church title="Plan a visit" section="Pages" eyebrow="New here?" heading="Plan a visit" lead="We are glad you are thinking about coming. Here is what to expect.">
  <div class="wrap body">
    <img class="photo" src="/img/potluck.svg" alt="Neighbors sharing a meal at a long table in the fellowship hall" width="800" height="560" style="max-width:880px;margin:0 auto 3rem" />
    <div class="info-grid">
      <section class="info"><h2>Times</h2><ul style="padding-left:1.2rem;margin:0">{services.map((s) => <li><strong>{s.day}, {s.time}:</strong> {s.what}</li>)}</ul></section>
      <section class="info"><h2>Where</h2><p>{site.address}. Free parking is in the lot on Elm Street. The front entrance has no steps, and an accessible restroom is off the main hall.</p></section>
      <section class="info"><h2>What to wear</h2><p>Whatever is comfortable. You will see jeans and you will see ties.</p></section>
      <section class="info"><h2>Children</h2><p>Children are welcome in the service. A nursery and Sunday school are open during the 10:45 a.m. talk.</p></section>
    </div>
    <div class="narrow prose"><h2 style="margin-top:0">Questions</h2><p>Call {site.phone} or email <a href={`mailto:${site.email}`}>{site.email}</a>. We will write back within two working days.</p></div>
  </div>
</Church>
