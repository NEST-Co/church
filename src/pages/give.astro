---
import Church from '../layouts/Church.astro';
---
<Church title="Give" section="Pages" eyebrow="Generosity" heading="Give" lead="Giving is a way to share in the life of the church and its neighbors. Everything here is optional, and visitors are never expected to give.">
  <div class="wrap body">
    <div class="info-grid">
      <section class="info"><h2>In person</h2><p>In the offering plate on Sunday.</p></section>
      <section class="info"><h2>By check</h2><p>Mailed to the church office.</p></section>
      <section class="info"><h2>Online</h2><p>Through the church's giving provider. <em>This concept site has no payment link, since the church is fictional.</em></p></section>
    </div>
    <div class="narrow prose"><h2 style="margin-top:0">Where it goes</h2><p>Gifts support worship, the building, the food pantry, and the youth program.</p></div>
  </div>
</Church>
